---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<div class="contact-links">
  <a href={`mailto:${profile.email}`}><Icon name="mail" />{profile.email}</a>
  <a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" />LinkedIn<span class="sr-only new-tab-note"> (opens in a new tab)</span></a>
  <a href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" />GitHub<span class="sr-only new-tab-note"> (opens in a new tab)</span></a>
</div>
