---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { withBase } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const number = String(project.data.order).padStart(2, '0');
---

<!-- The index row: the whole row is the link into the study's own page. -->
<li class="project-row">
  <a class="row-link" href={withBase(`/work/${project.id}/`)}>
    <span class="row-inner">
      <span class="order" aria-hidden="true">{number}</span>
      <h3 class="project-title">{project.data.title}</h3>
      <span class="arrow" aria-hidden="true">&rarr;</span>
      <span class="summary">{project.data.summary}</span>
      <span class="row-tags"><TagList items={project.data.stack} variant="inline" /></span>
    </span>
  </a>
</li>