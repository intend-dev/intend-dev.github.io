---
import { withBase } from '../lib/url';

interface Props {
  title: string;
  target: string;
  message: string;
}

const { title, target, message } = Astro.props;
const home = new URL(withBase('/'), Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={home} />
    <meta name="robots" content="noindex, follow" />
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
    <noscript><meta http-equiv="refresh" content={`0; url=${target}`} /></noscript>
  </head>
  <body>
    <p><a href={target}>{message}</a></p>
  </body>
</html>
