---
// Card art: one hand-drawn SVG per study, diagramming the project's own mechanism
// (no stock art, no licence to read). Inline SVG so it follows the theme. Every shape
// carries, so the reveal script can run the self-draw animation without
// measuring geometry; without JavaScript or with reduced motion the finished diagram
// is simply all there is.
interface Props {
  slug: string;
}

const { slug } = Astro.props;

const labels: Record<string, string> = {
  'code-review-orchestrator':
    'Diagram: a pull request fans out to three reviewer agents and folds into one validated report',
  'nasa-mission-rag':
    'Diagram: documents are chunked into a grid, and every answer sentence ends with a citation marker',
  'ai-budget-predicter':
    'Diagram: two outcome curves of different heights sit against one threshold line',
  'ai-development-harness':
    'Diagram: four isolated system lanes run and are captured, then fold into a reflection brief',
  'semantic-retrieval-benchmark':
    'Diagram: one shared query set flows into three retriever bars, the transformer bar the longest',
  'multimodal-moderation':
    'Diagram: four modality chips fan into a typed decision, then allow or block, with one trace',
};
const label = labels[slug] ?? 'Abstract diagram of the project';
---

<svg
  class="card-art"
  viewBox="0 0 400 250"
  role="img"
  aria-label={label}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  data-draw
  transition:name={`study-${slug}`}
>
  {slug === 'code-review-orchestrator' && (
    <>
      <title>One pull request, three reviewers, one typed report</title>
      {/* Pull request with its diff */}
      <rect x="20" y="88" width="84" height="74" rx="8" pathLength="1"></rect>
      <path d="M32 106h48" class="thin" pathLength="1"></path>
      <path d="M32 122h44" class="accent" pathLength="1"></path>
      <path d="M32 138h32" stroke-dasharray="4 5" pathLength="1"></path>
      <path d="M32 154h52" class="accent" pathLength="1"></path>
      {/* The three specialist reviewers */}
      <circle cx="200" cy="52" r="16" pathLength="1"></circle>
      <circle cx="200" cy="125" r="16" pathLength="1"></circle>
      <circle cx="200" cy="198" r="16" pathLength="1"></circle>
      {/* Fan out, fold back in */}
      <path d="M104 125 184 52" pathLength="1"></path>
      <path d="M104 125h80" pathLength="1"></path>
      <path d="M104 125 184 198" pathLength="1"></path>
      <path d="M216 52 316 125" pathLength="1"></path>
      <path d="M216 125h100" pathLength="1"></path>
      <path d="M216 198 316 125" pathLength="1"></path>
      {/* The validated report */}
      <rect x="316" y="88" width="64" height="74" rx="8" pathLength="1"></rect>
      <path d="M332 118l9 9 17-19" class="accent" pathLength="1"></path>
      <path d="M332 142h28" class="thin" pathLength="1"></path>
      <path d="M332 154h20" class="thin" pathLength="1"></path>
    </>
  )}
  {slug === 'nasa-mission-rag' && (
    <>
      <title>Chunked documents in, sentences with citations out</title>
      {/* The corpus: a stack of documents */}
      <rect x="36" y="64" width="72" height="48" rx="4" pathLength="1"></rect>
      <rect x="28" y="54" width="72" height="48" rx="4" pathLength="1"></rect>
      <rect x="20" y="44" width="72" height="48" rx="4" pathLength="1"></rect>
      <path d="M32 64h46" class="thin" pathLength="1"></path>
      <path d="M32 78h38" class="thin" pathLength="1"></path>
      {/* The chunk grid; three chunks retrieved */}
      <rect x="150" y="70" width="16" height="16" rx="2" pathLength="1"></rect>
      <rect x="170" y="70" width="16" height="16" rx="2" pathLength="1"></rect>
      <rect x="190" y="70" width="16" height="16" rx="2" class="hit" pathLength="1"></rect>
      <rect x="210" y="70" width="16" height="16" rx="2" pathLength="1"></rect>
      <rect x="150" y="90" width="16" height="16" rx="2" class="hit" pathLength="1"></rect>
      <rect x="170" y="90" width="16" height="16" rx="2" pathLength="1"></rect>
      <rect x="190" y="90" width="16" height="16" rx="2" pathLength="1"></rect>
      <rect x="210" y="90" width="16" height="16" rx="2" pathLength="1"></rect>
      <rect x="150" y="110" width="16" height="16" rx="2" pathLength="1"></rect>
      <rect x="170" y="110" width="16" height="16" rx="2" pathLength="1"></rect>
      <rect x="190" y="110" width="16" height="16" rx="2" pathLength="1"></rect>
      <rect x="210" y="110" width="16" height="16" rx="2" class="hit" pathLength="1"></rect>
      <path d="M238 110h40m-9-7 9 7-9 7" pathLength="1"></path>
      {/* The answer: every sentence ends in a citation marker */}
      <path d="M292 78h60" class="thin" pathLength="1"></path>
      <circle cx="362" cy="72" r="5" class="dot" pathLength="1"></circle>
      <path d="M292 112h60" class="thin" pathLength="1"></path>
      <circle cx="362" cy="106" r="5" class="dot" pathLength="1"></circle>
      <path d="M292 146h60" class="thin" pathLength="1"></path>
      <circle cx="362" cy="140" r="5" class="dot" pathLength="1"></circle>
    </>
  )}
  {slug === 'ai-budget-predicter' && (
    <>
      <title>Two outcome curves of different heights against one threshold</title>
      {/* Baseline and the two groups' outcome curves */}
      <path d="M36 196h328" class="thin" pathLength="1"></path>
      <path d="M56 196c60 0 70-132 100-132s40 132 100 132" pathLength="1"></path>
      <path d="M156 196c60 0 70-80 100-80s40 80 100 80" class="dash" pathLength="1"></path>
      <circle cx="156" cy="64" r="4" class="dot" pathLength="1"></circle>
      <circle cx="256" cy="116" r="4" class="dot" pathLength="1"></circle>
      {/* The threshold the audit holds the model to */}
      <path d="M256 36v160" class="accent" stroke-dasharray="5 7" pathLength="1"></path>
    </>
  )}
  {slug === 'ai-development-harness' && (
    <>
      <title>Four isolated runs captured, folded into one brief</title>
      {/* The four reference systems, each its own lane */}
      <rect x="24" y="48" width="24" height="120" rx="3" pathLength="1"></rect>
      <rect x="68" y="48" width="24" height="120" rx="3" pathLength="1"></rect>
      <rect x="112" y="48" width="24" height="120" rx="3" pathLength="1"></rect>
      <rect x="156" y="48" width="24" height="120" rx="3" pathLength="1"></rect>
      <path d="M186 125h20m-9-7 9 7-9 7" pathLength="1"></path>
      {/* The captured artefacts, checked off */}
      <rect x="214" y="70" width="104" height="110" rx="8" pathLength="1"></rect>
      <path d="M228 96l6 6 11-12" class="accent" pathLength="1"></path>
      <path d="M252 96h48" class="thin" pathLength="1"></path>
      <path d="M228 122l6 6 11-12" class="accent" pathLength="1"></path>
      <path d="M252 122h48" class="thin" pathLength="1"></path>
      <path d="M228 148l6 6 11-12" class="accent" pathLength="1"></path>
      <path d="M252 148h48" class="thin" pathLength="1"></path>
      <path d="M228 170l6 6 11-12" class="accent" pathLength="1"></path>
      <path d="M252 170h40" class="thin" pathLength="1"></path>
      <path d="M318 125h22m-9-7 9 7-9 7" pathLength="1"></path>
      {/* The reflection brief */}
      <rect x="344" y="86" width="44" height="78" rx="4" pathLength="1"></rect>
      <path d="M352 104h28" class="thin" pathLength="1"></path>
      <path d="M352 118h20" class="thin" pathLength="1"></path>
      <path d="M352 132h26" class="thin" pathLength="1"></path>
      <path d="M352 146h16" class="thin" pathLength="1"></path>
    </>
  )}
  {slug === 'semantic-retrieval-benchmark' && (
    <>
      <title>One query set, three retriever bars</title>
      {/* The shared 2,000 queries */}
      <circle cx="28" cy="46" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="39" cy="46" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="50" cy="46" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="61" cy="46" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="72" cy="46" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="83" cy="46" r="2.5" class="dot" pathLength="1"></circle>
      <circle cx="94" cy="46" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="105" cy="46" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="28" cy="58" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="39" cy="58" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="50" cy="58" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="61" cy="58" r="2.5" class="dot" pathLength="1"></circle>
      <circle cx="72" cy="58" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="83" cy="58" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="94" cy="58" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="105" cy="58" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="28" cy="70" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="39" cy="70" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="50" cy="70" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="61" cy="70" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="72" cy="70" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="83" cy="70" r="2.5" class="thin" pathLength="1"></circle>
      <circle cx="94" cy="70" r="2.5" class="dot" pathLength="1"></circle>
      <circle cx="105" cy="70" r="2.5" class="thin" pathLength="1"></circle>
      <path d="M80 84v18m-7-9 7 9 7-9" pathLength="1"></path>
      {/* Three retrievers on the same queries; MPNet the longest */}
      <rect x="24" y="120" width="164" height="18" rx="2" pathLength="1"></rect>
      <rect x="24" y="156" width="172" height="18" rx="2" pathLength="1"></rect>
      <rect x="24" y="192" width="230" height="18" rx="2" class="accent" pathLength="1"></rect>
    </>
  )}
  {slug === 'multimodal-moderation' && (
    <>
      <title>Four modalities into one typed decision, allow or block</title>
      {/* The modality chips: text, image, video, audio */}
      <rect x="20" y="48" width="64" height="34" rx="6" pathLength="1"></rect>
      <path d="M32 60h28" class="thin" pathLength="1"></path>
      <path d="M32 70h20" class="thin" pathLength="1"></path>
      <rect x="20" y="98" width="64" height="34" rx="6" pathLength="1"></rect>
      <rect x="34" y="106" width="20" height="18" rx="2" class="thin" pathLength="1"></rect>
      <rect x="20" y="148" width="64" height="34" rx="6" pathLength="1"></rect>
      <path d="M44 156l14 9-14 9" pathLength="1"></path>
      <rect x="20" y="198" width="64" height="34" rx="6" pathLength="1"></rect>
      <path d="M34 215q6-9 12 0t12 0" pathLength="1"></path>
      {/* The fan into the typed decision */}
      <path d="M84 65 212 121" pathLength="1"></path>
      <path d="M84 115 210 128" pathLength="1"></path>
      <path d="M84 165 210 141" pathLength="1"></path>
      <path d="M84 215 212 150" pathLength="1"></path>
      {/* The decision, its rationale check, the trace */}
      <path d="M252 129 230 92 208 129 230 166Z" pathLength="1"></path>
      <path d="M222 129l6 6 12-13" class="accent" pathLength="1"></path>
      <path d="M254 112h44m-9-7 9 7-9 7" pathLength="1"></path>
      <circle cx="322" cy="112" r="15" pathLength="1"></circle>
      <path d="M314 112l6 6 11-12" class="accent" pathLength="1"></path>
      <path d="M254 142h38c16 2 16 44 30 50" pathLength="1"></path>
      <path d="M330 196l14 14m0-14l-14 14" pathLength="1"></path>
      <path d="M230 174v56" class="dash" pathLength="1"></path>
    </>
  )}
  {!(slug in labels) && (
    <>
      <title>Project diagram</title>
      <rect x="28" y="70" width="88" height="110" rx="8" pathLength="1"></rect>
      <path d="M136 125h92m-11-8 11 8-11 8" pathLength="1"></path>
      <rect x="244" y="70" width="128" height="110" rx="8" pathLength="1"></rect>
      <path d="M264 104h88" class="thin" pathLength="1"></path>
      <path d="M264 125h64" class="thin" pathLength="1"></path>
      <path d="M264 146h76" class="thin" pathLength="1"></path>
    </>
  )}
</svg>