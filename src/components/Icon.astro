---
interface Props {
  name: 'mail' | 'linkedin' | 'github' | 'file' | 'globe' | 'sun' | 'moon';
  class?: string;
}

const { name, class: className } = Astro.props;
const solid = name === 'linkedin' || name === 'github';
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={solid ? 'currentColor' : 'none'}
  stroke={solid ? 'none' : 'currentColor'}
  stroke-width={solid ? undefined : 1.6}
  stroke-linecap={solid ? undefined : 'round'}
  stroke-linejoin={solid ? undefined : 'round'}
>
  {name === 'mail' && (
    <>
      <rect x="2.75" y="5" width="18.5" height="14" rx="2" />
      <path d="m3.5 6.6 8.5 6 8.5-6" />
    </>
  )}
  {name === 'linkedin' && (
    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.25h4V21H3zM10 9.25h3.83v1.61h.05a4.2 4.2 0 0 1 3.78-2.08c4.04 0 4.79 2.66 4.79 6.12V21h-4v-5.35c0-1.28-.02-2.92-1.78-2.92-1.78 0-2.05 1.39-2.05 2.83V21h-4z" />
  )}
  {name === 'github' && (
    <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48 0-.24-.01-1.04-.01-1.89-2.78.6-3.37-1.19-3.37-1.19-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.7-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .26.18.57.69.48A10 10 0 0 0 12 2Z" />
  )}
  {name === 'file' && (
    <>
      <path d="M13.5 3H7.5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V8z" />
      <path d="M13.5 3v5h5" />
      <path d="M9 13.5h6M9 17h4" />
    </>
  )}
  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18" />
      <path d="M12 3c2.8 3.4 2.8 14.6 0 18M12 3c-2.8 3.4-2.8 14.6 0 18" />
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.6 5.6l1.55 1.55M16.85 16.85 18.4 18.4M18.4 5.6l-1.55 1.55M7.15 16.85 5.6 18.4" />
    </>
  )}
  {name === 'moon' && <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z" />}
</svg>
