---
interface Props {
  id: string;
  title: string;
  note?: string;
}

const { id, title, note } = Astro.props;
---

<details class="fact" id={id}>
  <summary class="fact-summary">
    <span class="fact-marker" aria-hidden="true"></span>
    <h3>{title}</h3>
    {note && <span class="fact-note">{note}</span>}
  </summary>
  <div class="fact-body">
    <slot />
  </div>
</details>
