---
import type { CollectionEntry } from 'astro:content';
import ProjectRow from './ProjectRow.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  navArea: 'examples' | 'work';
}

const { projects, navArea } = Astro.props;

// Each case-study row opens its full study in place, so a click never leaves
// the page. The Markdown sections are h2 in the source; they sit two levels down
// here so the outline stays valid beneath each row's h3 title, and their ids get a
// per-study prefix so all six can share one document.
const inlineCases = projects.map((project) => ({
  project,
  html: (project.rendered?.html ?? '')
    .replace(/<(\/?)h([23])\b/g, (_, close, level) => `<${close}h${Number(level) + 2}`)
    .replace(/\sid="([^"]*)"/g, (_, id) => ` id="case-${project.id}-${id}"`)
    .replace(/href="#([^"]*)"/g, (_, id) => `href="#case-${project.id}-${id}"`),
}));
---

<ul class="project-list">
  {inlineCases.map(({ project, html }) => <ProjectRow project={project} html={html} navArea={navArea} />)}
</ul>

<script is:inline>
  (() => {
    const openHashTarget = () => {
      const raw = location.hash.slice(1);
      if (!raw) return;
      let id;
      try {
        id = decodeURIComponent(raw);
      } catch {
        return;
      }
      const target = document.getElementById(id);
      if (!target) return;
      const details = target.closest('details');
      if (details && !details.open) {
        details.open = true;
        // Let the opened body lay out before measuring the scroll target.
        requestAnimationFrame(() => details.scrollIntoView({ block: 'start' }));
      }
    };

    openHashTarget();
    window.addEventListener('hashchange', openHashTarget);

    // One case study at a time: opening a row closes the others, so the page keeps a
    // single reading position. Printing deliberately opens every row, so this stands
    // down while the print handlers run.
    let printing = false;
    const cases = [...document.querySelectorAll('.case-disclosure')];
    for (const details of cases) {
      details.addEventListener('toggle', () => {
        if (printing || !details.open) return;
        let switched = false;
        for (const other of cases) {
          if (other !== details && other.open) {
            other.open = false;
            switched = true;
          }
        }
        // Closing the previous row removes its whole body above this one, so the
        // clicked row would otherwise open already scrolled into the middle. Put its
        // header back under the site header and start the body from the top.
        if (switched) {
          requestAnimationFrame(() => {
            const head = document.querySelector('.site-header');
            const offset = head ? head.getBoundingClientRect().height : 0;
            const top = details.getBoundingClientRect().top + window.scrollY - offset;
            window.scrollTo({ top, behavior: 'instant' });
          });
        }
      });
    }

    // The open row header sticks under the site header, so the "At a glance" sidebar
    // has to clear its measured height instead of a guessed one.
    const syncRowHeads = () => {
      for (const details of document.querySelectorAll('.case-disclosure[open]')) {
        const summary = details.querySelector('summary');
        if (summary) details.style.setProperty('--row-head-h', `${Math.round(summary.getBoundingClientRect().height)}px`);
      }
    };
    for (const details of document.querySelectorAll('.case-disclosure')) {
      details.addEventListener('toggle', syncRowHeads);
    }
    window.addEventListener('resize', syncRowHeads);
    if (document.fonts) document.fonts.ready.then(syncRowHeads);

    // The open row header and the open fact header paint their lower edge only while
    // pinned under the site header. At rest that edge would sit a few pixels above the
    // next rule, and the pair reads as a doubled line; once pinned, the bar covers
    // scrolling text and needs a line to mark where it ends. Pinned means exactly at
    // the header: a summary clamped at its section's bottom edge no longer covers
    // moving text, so it keeps no edge even though it sits above the threshold.
    let stuckQueued = false;
    const syncStuck = () => {
      stuckQueued = false;
      for (const summary of document.querySelectorAll('.case-disclosure > summary, .fact > .fact-summary')) {
        const offset = parseFloat(getComputedStyle(summary).top) || 0;
        const pinned = summary.parentElement.open && Math.abs(summary.getBoundingClientRect().top - offset) <= 0.5;
        summary.toggleAttribute('data-stuck', pinned);
      }
    };
    const queueStuck = () => {
      if (stuckQueued) return;
      stuckQueued = true;
      requestAnimationFrame(syncStuck);
    };
    window.addEventListener('scroll', queueStuck, { passive: true });
    window.addEventListener('resize', queueStuck);
    for (const details of document.querySelectorAll('.case-disclosure, .fact')) {
      details.addEventListener('toggle', queueStuck);
    }
    syncStuck();

    // Only the blocks this run opened are closed again, so a block the visitor had
    // open before printing is still open afterwards.
    const printOpened = [];
    window.addEventListener('beforeprint', () => {
      printing = true;
      document.querySelectorAll('details:not([open])').forEach((details) => {
        details.open = true;
        printOpened.push(details);
      });
    });
    window.addEventListener('afterprint', () => {
      printOpened.forEach((details) => {
        details.open = false;
      });
      printOpened.length = 0;
      printing = false;
    });
  })();
</script>