---
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../lib/url';
import copy from '../data/copy.json';
---

<div class="scroll-sentinel" aria-hidden="true"></div>

<header class="site-header" transition:persist>
  <div class="wrap">
    <a class="wordmark" href={withBase('/')}>Francisco Mateus</a>
    <div class="header-actions">
      <div class="header-work">
        <nav class="site-nav" aria-label="Primary">
          <!-- data-nav-key names the section each link tracks; the projects link opens
               the home featured cards. -->
          <a data-nav-key="projects" href={withBase('/#work')}>{copy.nav.projects}</a>
          <!-- The Work menu item is commented by the owner on 2026-10-23: too much
               technical data in the menu for now; the all-six page stays live on /work
               (the CV PDF links it); restoring it means uncommenting this block here. -->
          <a data-nav-key="about" href={withBase('/#about')}>{copy.sections.about}</a>
          <a data-nav-key="contact" href={withBase('/#contact')}>{copy.sections.contact}</a>
        </nav>
        <!-- Breadcrumb for the Work area. Absolute, so the bar keeps one height. -->
        <span class="nav-current" aria-hidden="true" hidden></span>
      </div>
      <ThemeToggle />
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('.site-header');
    if (!header) return;

    const sync = () => {
      const height = Math.round(header.getBoundingClientRect().height);
      if (height > 0) document.documentElement.style.setProperty('--header-h', `${height}px`);
    };

    sync();
    if (document.fonts) document.fonts.ready.then(sync);

    // The header persists across View Transitions, so this script runs once per full
    // load and re-resolves per page swap; the guards keep the listeners single even
    // if the browser ever re-runs the script.
    if (!window.__fmHeaderRO && 'ResizeObserver' in window) {
      window.__fmHeaderRO = true;
      new ResizeObserver(sync).observe(header);
    }

    let scrolledObserver = null;
    let sections = [];
    let links = new Map();
    let atEnd = false;

    let pending = false;
    const schedule = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        update();
      });
    };

    const trackSections = () => {
      const label = document.querySelector('.nav-current');
      if (!label) return;

      // Each page contributes the sections it renders; entries that do not exist are
      // filtered out, so a study page, which tracks none of them, keeps the breadcrumb
      // hidden and no link highlighted.
      sections = [
        { id: 'overview', crumb: null },
        { id: 'work', crumb: null, nav: 'projects' },
        { id: 'all-work', crumb: null },
        { id: 'capabilities', crumb: null },
        { id: 'story', crumb: null, nav: 'about' },
        { id: 'about', crumb: null, nav: 'about' },
        { id: 'contact', crumb: null, nav: 'contact' },
      ]
        .map((section) => ({ ...section, element: document.getElementById(section.id) }))
        .filter((section) => section.element);

      if (sections.length === 0) return;

      links = new Map();
      for (const link of document.querySelectorAll('.site-nav a')) {
        if (link.dataset.navKey) links.set(link.dataset.navKey, link);
      }

      const end = document.querySelector('.scroll-end');
      if (end && 'IntersectionObserver' in window) {
        if (!scrolledObserver) {
          scrolledObserver = new IntersectionObserver(([entry]) => {
            atEnd = entry.isIntersecting && document.documentElement.scrollHeight > innerHeight + 2;
            update();
          });
        }
        scrolledObserver.disconnect();
        scrolledObserver.observe(end);
      }
      update();
      if (document.fonts) document.fonts.ready.then(update);
    };

    const update = () => {
      if (sections.length === 0) return;
      const height = header.getBoundingClientRect().height;
      const horizon = window.scrollY + height + 24;
      let current = sections[0];
      for (const section of sections) {
        if (section.element.getBoundingClientRect().top + window.scrollY <= horizon) current = section;
      }
      // A short final section can sit below the horizon on a tall viewport.
      if (atEnd) current = sections[sections.length - 1];
      // The crumb label resolves per call: study pages have none and stay clean.
      const crumbLabel = document.querySelector('.nav-current');
      if (crumbLabel) {
        crumbLabel.textContent = current.crumb ?? '';
        crumbLabel.hidden = !current.crumb;
      }
      for (const [target, link] of links) {
        if (link.getAttribute('aria-current') === 'page') continue;
        if (current.nav && target === current.nav) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    if (!window.__fmHeaderTracking) {
      window.__fmHeaderTracking = true;
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      document.addEventListener('astro:page-load', () => {
        sync();
        trackSections();
      });
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', trackSections);
      else trackSections();
    }
  })();
</script>
