---
interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonicalPath?: string;
}

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import '../styles/global.css';

const { title, description, jsonLd, type = 'website', noindex = false, canonicalPath } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme-light="#f7f4ed" data-theme-dark="#0c0e0d">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <script is:inline>
      // Resolve the stored choice, then re-apply the full state (the html attribute and
      // both metas). The re-apply is not optional: headless and real browsers alike
      // measure that a View-Transition swap replaces the html element's attributes (the
      // incoming page's server markup carries no data-theme), so without it every
      // swap lands on the css default. after-swap runs before the new page paints.
      const applyTheme = () => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (error) {
          // Storage can be blocked; fall back to the default below.
        }
        // Light is the default (owner decision): only a stored choice or a toggle press
        // lands on dark. The OS colour scheme no longer picks the theme for a visitor
        // who never chose one.
        const dark = stored ? stored === 'dark' : false;
        const root = document.documentElement;
        root.dataset.theme = dark ? 'dark' : 'light';
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
          meta.content = root.dataset[dark ? 'themeDark' : 'themeLight'];
        }
      };
      // Header.astro's inline script does not survive swaps (its element ships fresh
      // and scriptless, and its content dedupes away), so nothing re-measures the
      // header there; a swap also replaces <html>, killing the measured --header-h
      // with it. Measured: the sticky fact bars rode the 7rem fallback after a swap
      // (a 25px gap at desktop, 11px under the phone menu). Re-measure alongside the
      // theme, from the after-swap hook proven to survive.
      const syncHeader = () => {
        const header = document.querySelector('.site-header');
        if (!header) return;
        const height = Math.round(header.getBoundingClientRect().height);
        if (height > 0) document.documentElement.style.setProperty('--header-h', `${height}px`);
      };
      applyTheme();
      syncHeader();
      // One listener for the document's lifetime, however many times the swap re-runs
      // this inline script. The after-swap measure can land before the incoming
      // header's rows settle (measured: 122 mid-assembly, 174 settled at 320px), so
      // it retries on the next frame.
      if (!window.__fmTheme) {
        window.__fmTheme = true;
        document.addEventListener('astro:after-swap', () => {
          applyTheme();
          syncHeader();
          requestAnimationFrame(syncHeader);
        });
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f7f4ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e0d" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        // Reveal and self-draw: the markup is always the finished state. Pending states
        // are applied by this script only when the effect will actually run, so a
        // no-JS visitor, a reduced-motion visitor, and any print never see hidden
        // content. Nothing above the fold is ever hidden, so the hero's first paint is
        // exactly what it would be without this script.
        const still = typeof matchMedia !== 'undefined' && !matchMedia('(prefers-reduced-motion: no-preference)').matches;
        const markRevealed = () => {
          for (const el of document.querySelectorAll('[data-reveal]:not([data-revealed])')) el.setAttribute('data-revealed', '');
        };
        if (still || !('IntersectionObserver' in window)) {
          markRevealed();
          // Self-draw: with motion suppressed the finished diagram is the default.
          if (!window.__fmRevealDoc) {
            window.__fmRevealDoc = true;
            document.addEventListener('astro:page-load', markRevealed);
          }
          return;
        }
        const bind = () => {
          for (const el of document.querySelectorAll('[data-reveal]:not([data-revealed])')) {
            if (el.getBoundingClientRect().top < window.innerHeight) {
              el.setAttribute('data-revealed', '');
              continue;
            }
            // The pending state starts hidden only where the media query allows motion.
            el.setAttribute('data-pending', '');
            io.observe(el);
          }
          for (const el of document.querySelectorAll('svg[data-draw]:not([data-drawing])')) {
            // Every art draws once per load: art already in view draws immediately (the
            // visitor watches it start to finish), art below the fold waits to be seen.
            if (el.getBoundingClientRect().top >= window.innerHeight) {
              el.setAttribute('data-draw-pending', '');
              io.observe(el);
              continue;
            }
            el.setAttribute('data-drawing', '');
          }
        };
        if (!window.__fmReveal) {
          window.__fmReveal = true;
          window.__fmRevealIO = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const el = entry.target;
                if (el.matches('svg[data-draw]')) {
                  el.removeAttribute('data-draw-pending');
                  el.setAttribute('data-drawing', '');
                } else {
                  el.removeAttribute('data-pending');
                  el.setAttribute('data-revealed', '');
                }
                window.__fmRevealIO.unobserve(el);
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
          );
          document.addEventListener('astro:page-load', bind);
        }
        const io = window.__fmRevealIO;
        bind();
      })();
    </script>
  </body>
</html>
