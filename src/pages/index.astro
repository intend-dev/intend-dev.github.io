---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Fact from '../components/Fact.astro';
import portrait from '../assets/francisco-mateus.png';
import { profile } from '../data/profile';
import { certifications, education, experience, skillGroups } from '../data/career';
import { withBase } from '../lib/url';
import copy from '../data/copy.json';

const projects = (await getCollection('projects', ({ data }) => data.status === 'completed' && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
// The profile shows the featured studies as cards; every study lives on its own page.
const featured = projects.filter((project) => project.data.featured);

const countBy = (issuer: string) => certifications.filter((certification) => certification.issuer === issuer).length;
const certCounts = `${countBy('Udacity Institute of AI & Technology')} Udacity AI · ${countBy('Stibo Systems')} Stibo Systems · ${countBy('ServiceNow')} ServiceNow expired · ${countBy('PeopleCert')} ITIL v4`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role.replace(' · ', ', '),
  email: profile.email,
  url: new URL(withBase('/'), Astro.site).toString(),
  sameAs: [profile.linkedin, profile.github],
  worksFor: { '@type': 'Organization', name: profile.employer },
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.location.split(',')[0],
    addressCountry: profile.countryCode,
  },
  knowsAbout: [
    'Retrieval-augmented generation',
    'AI agents',
    'Model Context Protocol',
    'Agentic AI',
    'LangGraph',
    'LLM evaluation',
    'Stibo STEP',
    'Master data management',
    'Product information management',
    'Python',
    'PyTorch',
  ],
};

const capabilities = [
  {
    title: 'AI systems',
    body: 'Retrieval-augmented generation (RAG), agents over MCP, tool-using systems, and the evaluation loops that keep them honest.',
  },
  {
    title: 'Evaluation and governance',
    body: 'RAGAS and retrieval metrics, fairness audits, model cards, token and time budgets, and traces that make a run reproducible.',
  },
  {
    title: 'Master data',
    body: 'Stibo STEP, PIM and MDM, business rules, workflows, data modelling, and release packaging across DEV, TEST, and PROD.',
  },
];
---

<BaseLayout
  title="Francisco Mateus · Application Specialist, AI and Master Data"
  description="Portfolio of Francisco Mateus: application specialist for AI systems and master data, working on RAG, AI agents, evaluation, and Stibo STEP."
  jsonLd={jsonLd}
>
  <section class="hero" id="overview">
    <div class="wrap">
      <p class="eyebrow">APPLICATION SPECIALIST · AI AND MASTER DATA</p>
      <h1>{profile.headline}</h1>
      <p class="intro">{profile.intro}</p>
      <div class="actions">
        <a class="button button--solid" href={withBase('/#work')}>Read selected projects</a>
        <a class="button" href={withBase('/Francisco_Mateus_CV.pdf')} download>Download CV</a>
      </div>
      <p class="availability">{profile.availability}</p>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <SectionHeading title={copy.sections.projects} note={copy.work.note} />
      <ul class="project-cards">
        {featured.map((project) => <ProjectCard project={project} />)}
      </ul>
      <p class="case-more"><a href={withBase('/work')}>{copy.projects.more}</a>.</p>
      <p class="disclosure">{copy.work.disclosure}</p>
    </div>
  </section>

  <!-- Fact section headings stay outside <summary>. A heading inside a summary becomes part of
       the disclosure's accessible name and is announced twice by some screen readers. The
       case-study rows are the exception: their title is the control's only visible label. -->
  <section class="section" id="capabilities">
    <div class="wrap" data-reveal>
      <SectionHeading title={copy.sections.capabilities} note="AI systems, evaluation and governance, and master data." />
      <div class="capabilities">
        {capabilities.map((capability) => (
          <div class="capability">
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="story">
    <div class="wrap" data-reveal>
      <SectionHeading eyebrow={copy.story.eyebrow} title={copy.story.title} />
      <div class="story">
        <div class="story-text">
          {copy.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <Image
          src={portrait}
          alt="Portrait of Francisco Mateus"
          widths={[160, 320]}
          sizes="(min-width: 900px) 10rem, 80vw"
          class="story-portrait"
        />
      </div>

      <!-- The About cluster: the story, then its receipts. The menu's About me opens
           this section at the story; the facts follow the narrative. The old About
           heading was dropped by the owner: it restated the hero and the contact note. -->
      <div class="facts">
        <Fact id="experience" title={copy.sections.experience} note="Six roles across data, platforms, and support">
          {experience.map((role) => (
            <article class="cv-entry">
              <div class="entry-head">
                <div>
                  <h4>{role.company}</h4>
                  <p class="role">{role.role}</p>
                  {'location' in role && role.location && <p class="location">{role.location}</p>}
                </div>
                <span class="period">{role.period}</span>
              </div>
              <ul>
                {role.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </Fact>

        <Fact id="skills" title={copy.sections.skills} note="Five groups: AI and ML, AI engineering, data, Stibo, development">
          {skillGroups.map((group) => (
            <div class="skill-group">
              <h4>{group.name}</h4>
              <p>{group.skills}</p>
            </div>
          ))}
        </Fact>

        <Fact id="certifications" title={copy.sections.certifications} note={certCounts}>
          <p class="cert-note">
            ServiceNow dates are first-issued dates; all four were renewed periodically while active and are now expired.
          </p>
          <ul class="cert-list">
            {certifications.map((certification) => (
              <li>
                <span>{certification.name}</span>
                <span class="cert-meta">
                  {certification.issuer} · {certification.date}
                  {'status' in certification && certification.status ? ` · ${certification.status}` : ''}
                </span>
              </li>
            ))}
          </ul>
          <p class="cert-more">
            <a href="https://www.linkedin.com/in/franc1scomat/details/certifications/" target="_blank" rel="noopener noreferrer">Full certification list on LinkedIn<span class="sr-only new-tab-note"> (opens in a new tab)</span></a>
          </p>
        </Fact>

        <Fact id="education" title={copy.sections.education}>
          {education.map((entry) => (
            <article class="cv-entry">
              <h4>{entry.institution}</h4>
              <p class="role">{entry.credential}</p>
              {'detail' in entry && entry.detail && <p class="muted">{entry.detail}</p>}
            </article>
          ))}
        </Fact>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap" data-reveal>
      <div class="contact-grid">
        <SectionHeading title={copy.sections.contact} note={profile.availability} />
        <ContactLinks />
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      // Sticky fact headers: an open summary pins under the site header and paints its
      // lower edge only while pinned (data-stuck), exactly at the header and never while
      // clamped at the section's end, where it covers no moving text. The window-level
      // listeners bind once and query live DOM, so they survive View Transitions; the
      // per-element toggle listeners rebind on every page load because the facts are
      // the fresh page's own elements.
      const syncStuck = () => {
        stuckQueued = false;
        for (const summary of document.querySelectorAll('.fact > .fact-summary')) {
          const offset = parseFloat(getComputedStyle(summary).top) || 0;
          const pinned = summary.parentElement.open && Math.abs(summary.getBoundingClientRect().top - offset) <= 0.5;
          summary.toggleAttribute('data-stuck', pinned);
        }
      };
      let stuckQueued = false;
      const queueStuck = () => {
        if (stuckQueued) return;
        stuckQueued = true;
        requestAnimationFrame(syncStuck);
      };

      // Printing opens the closed facts; only the blocks this run opened are closed
      // again, so a fact the visitor already had open stays open afterwards.
      const printOpened = [];
      const openForPrint = () => {
        document.querySelectorAll('.fact:not([open])').forEach((details) => {
          details.open = true;
          printOpened.push(details);
        });
      };
      const restoreAfterPrint = () => {
        printOpened.forEach((details) => {
          details.open = false;
        });
        printOpened.length = 0;
      };

      if (!window.__fmFacts) {
        window.__fmFacts = true;
        window.addEventListener('scroll', queueStuck, { passive: true });
        window.addEventListener('resize', queueStuck);
        window.addEventListener('beforeprint', openForPrint);
        window.addEventListener('afterprint', restoreAfterPrint);
      }

      const bind = () => {
        for (const details of document.querySelectorAll('.fact')) {
          details.addEventListener('toggle', queueStuck);
        }
        syncStuck();
      };
      bind();
      document.addEventListener('astro:page-load', bind);
    })();
  </script>
</BaseLayout>