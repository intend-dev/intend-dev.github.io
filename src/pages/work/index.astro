---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CaseList from '../../components/CaseList.astro';
import copy from '../../data/copy.json';

const projects = (await getCollection('projects', ({ data }) => data.status === 'completed' && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Case studies · Francisco Mateus"
  description="The six AI case studies of Francisco Mateus: RAG with enforced citations, agent orchestration, moderation, evaluation, fairness, retrieval benchmarks."
>
  <!-- The visible heading is the same section heading as on the profile, so the h1 names the
       page for the outline and assistive tech without repeating itself on screen. -->
  <h1 class="sr-only">{copy.nav.caseStudies}</h1>
  <section class="section" id="all-work">
    <div class="wrap">
      <SectionHeading title={copy.work.heading} note={copy.work.note} />
      <CaseList projects={projects} navArea="work" />
      <p class="disclosure">{copy.work.disclosure}</p>
    </div>
  </section>
</BaseLayout>