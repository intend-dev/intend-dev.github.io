---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import copy from '../data/copy.json';
---

<BaseLayout title="Page not found · Francisco Mateus" description="That page is not here." noindex canonicalPath={withBase('/')}>
  <div class="wrap not-found">
    <p class="eyebrow">404</p>
    <h1>That page is not here.</h1>
    <p class="lede">The link may be out of date. The work and the record are still where they should be.</p>
    <div class="actions">
      <a class="button button--solid" href={withBase('/')}>Home</a>
      <a class="button" href={withBase('/#work')}>{copy.nav.projects}</a>
    </div>
  </div>
</BaseLayout>
